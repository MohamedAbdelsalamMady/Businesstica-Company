<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================
          Tree View
    ============================ -->
    <record id="view_zk_sync_log_tree" model="ir.ui.view">
        <field name="name">zk.sync.log.tree</field>
        <field name="model">zk.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Logs" create="false" edit="false">
                <field name="create_date"/>
                <field name="device_id"/>
                <field name="sync_type"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-danger="state == 'error'"
                       decoration-warning="state == 'warning'"
                       decoration-info="state == 'running'"/>
                <field name="records_processed"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <!-- ============================
          Form View
    ============================ -->
    <record id="view_zk_sync_log_form" model="ir.ui.view">
        <field name="name">zk.sync.log.form</field>
        <field name="model">zk.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log" create="false" edit="false">

                <header>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="device_id"/>
                            <field name="sync_type"/>
                            <field name="create_date"/>
                        </group>

                        <group>
                            <field name="records_processed"/>
                        </group>
                    </group>

                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- ============================
          Search View
    ============================ -->
    <record id="view_zk_sync_log_search" model="ir.ui.view">
        <field name="name">zk.sync.log.search</field>
        <field name="model">zk.sync.log</field>
        <field name="arch" type="xml">
            <search string="Search Sync Logs">

                <field name="device_id"/>
                <field name="sync_type"/>
                <field name="state"/>

                <filter name="filter_user_sync" string="User Sync"
                        domain="[('sync_type', '=', 'user')]"/>

                <filter name="filter_attendance_sync" string="Attendance Sync"
                        domain="[('sync_type', '=', 'attendance')]"/>

                <separator/>

                <filter name="filter_success" string="Success"
                        domain="[('state', '=', 'success')]"/>

                <filter name="filter_error" string="Error"
                        domain="[('state', '=', 'error')]"/>

                <filter name="filter_warning" string="Warning"
                        domain="[('state', '=', 'warning')]"/>

                <separator/>

                <filter name="filter_today" string="Today"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>

                <filter name="filter_this_week" string="This Week"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>

                <filter name="filter_this_month" string="This Month"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>

                <separator/>

                <filter name="filter_date" string="Date" date="create_date"/>

                <group expand="0" string="Group By">
                    <filter name="group_device" string="Device"
                            context="{'group_by': 'device_id'}"/>
                    <filter name="group_type" string="Sync Type"
                            context="{'group_by': 'sync_type'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================
          Action
    ============================ -->
    <record id="action_zk_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">zk.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_today': 1}</field>
    </record>

</odoo>
