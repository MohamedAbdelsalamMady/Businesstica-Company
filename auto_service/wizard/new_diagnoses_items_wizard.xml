<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="new_diagnoses_items_wizard_form" model="ir.ui.view">
        <field name="name">new.diagnoses.items.wizard.form</field>
        <field name="model">new.diagnoses.items.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="new_diagnoses_items_wizard_ids">
                        <list editable="bottom">
                            <field name="new_diagnoses_items_wizard_id" invisible="1"/>
                            <field name="product_id" required="1"/>
                            <field name="product_uom" required="1"/>
                            <field name="product_uom_qty"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="confirm" type="object" string="Confirm" class="oe_highlight" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="new_diagnoses_items_wizard_action" model="ir.actions.act_window">
        <field name="name">New Diagnoses Items Wizard</field>
        <field name="res_model">new.diagnoses.items.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>
