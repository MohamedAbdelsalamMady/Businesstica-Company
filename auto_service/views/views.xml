<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="auto_service.list">
      <field name="name">auto_service list</field>
      <field name="model">auto_service.auto_service</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="value"/>
          <field name="value2"/>
        </list>
      </field>
    </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="auto_service.action_window">
      <field name="name">auto_service window</field>
      <field name="res_model">auto_service.auto_service</field>
      <field name="view_mode">list,form</field>
    </record>


    <!-- server action to the one above -->

    <record model="ir.actions.server" id="auto_service.action_server">
      <field name="name">auto_service server</field>
      <field name="model_id" ref="model_auto_service_auto_service"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "list,form",
          "res_model": model._name,
        }
      </field>
    </record>


    <!-- Top menu item -->

    <menuitem name="auto_service" id="auto_service.menu_root"/>

    <!-- menu categories -->

    <menuitem name="Menu 1" id="auto_service.menu_1" parent="auto_service.menu_root"/>
    <menuitem name="Menu 2" id="auto_service.menu_2" parent="auto_service.menu_root"/>

    <!-- actions -->

    <menuitem name="List" id="auto_service.menu_1_list" parent="auto_service.menu_1"
              action="auto_service.action_window"/>
    <menuitem name="Server to list" id="auto_service" parent="auto_service.menu_2"
              action="auto_service.action_server"/>

  </data>
</odoo>