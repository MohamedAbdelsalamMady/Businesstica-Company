<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_workshop_mechanics_form" model="ir.ui.view">
        <field name="name">report.workshop.mechanics.form</field>
        <field name="model">report.workshop.mechanics</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="repair_order_number"/>
                            <field name="partner_id"/>
                            <field name="car_model"/>
                            <field name="plate_number"/>
                            <field name="date_entry"/>
                            <field name="reception_engineer"/>
                        </group>
                       <group>
                           <field name="customer_response"/>
                           <field name="spare_parts"/>
                           <field name="under_construction"/>
                           <field name="experience"/>
                           <field name="delivery"/>
                           <field name="fff"/>
                       </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="report_workshop_mechanics_list" model="ir.ui.view">
        <field name="name">report.workshop.mechanics.list</field>
        <field name="model">report.workshop.mechanics</field>
        <field name="arch" type="xml">
            <list>
                <field name="repair_order_number"/>
                <field name="partner_id"/>
                <field name="car_model"/>
                <field name="plate_number"/>
                <field name="date_entry"/>
                <field name="reception_engineer"/>
                <field name="customer_response"/>
                <field name="spare_parts"/>
                <field name="under_construction"/>
                <field name="experience"/>
                <field name="delivery"/>
            </list>
        </field>
    </record>


    <record id="report_workshop_mechanics_action" model="ir.actions.act_window">
        <field name="name">Report Workshop Mechanics</field>
        <field name="res_model">report.workshop.mechanics</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Report Workshop Mechanics
            </p>
        </field>
    </record>
</odoo>
