<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="service_name_form" model="ir.ui.view">
        <field name="name">service.name.form</field>
        <field name="model">service.name</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="done" type="object" string="Done" class="oe_highlight" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="service_type_id"/>

                        </group>
                        <group>
                            <field name="estimated_time" widget="float_time"/>
                            <field name="service_team_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Service Parts Lines">
                            <field name="service_parts_lines_ids">
                                <list editable="bottom" create="1" edit="1">
                                    <field name="service_name_id"
                                           invisible="1"/>
                                    <field name="product_id" invisible="1"/>

                                    <field name="task"/>
                                    <field name="spare_product_ids" widget="many2many_tags" string="Spare Parts" readonly="0"/>
                                    <field name="product_qty"
                                           widget="float_time" string="Time"/>
<!--                                    <field name="unit_price"/>-->
<!--                                    <field name="subtotal"/>-->
                                </list>
                            </field>
                        </page>
                        <page string="Spare Parts Lines">
                            <field name="spare_parts_lines_ids">
                                <list editable="bottom" create="1" edit="1" delete="0">
                                    <field name="service_name_id"
                                           invisible="1"/>
                                    <field name="task" readonly="1" optional="show"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="product_qty"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>


                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
            </form>

        </field>
    </record>

    <record id="service_name_list" model="ir.ui.view">
        <field name="name">service.name.list</field>
        <field name="model">service.name</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="service_type_id"/>
                <field name="estimated_time"/>
                <field name="service_team_id"/>
            </list>
        </field>
    </record>

    <record id="service_name_search" model="ir.ui.view">
        <field name="name">service.name.search</field>
        <field name="model">service.name</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="service_type_id"/>
                <field name="estimated_time"/>
                <field name="service_team_id"/>
            </search>
        </field>
    </record>



    <record id="service_name_action" model="ir.actions.act_window">
        <field name="name">Service Name</field>
        <field name="res_model">service.name</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Service Name
            </p>
        </field>
    </record>
</odoo>
