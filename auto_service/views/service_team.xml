<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="service_team_form" model="ir.ui.view">
        <field name="name">service.team.form</field>
        <field name="model">service.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="res_users_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Service Team">
                            <field name="users_ids" nolabel="1">
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
            </form>

        </field>
    </record>

    <record id="service_team_list" model="ir.ui.view">
        <field name="name">service.team.list</field>
        <field name="model">service.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="res_users_id"/>
            </list>
        </field>
    </record>

    <record id="service_team_search" model="ir.ui.view">
        <field name="name">service.team.search</field>
        <field name="model">service.team</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="res_users_id"/>
            </search>
        </field>
    </record>





    <record id="service_team_action" model="ir.actions.act_window">
        <field name="name">Service Team</field>
        <field name="res_model">service.team</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Service Team
            </p>
        </field>
    </record>
</odoo>
