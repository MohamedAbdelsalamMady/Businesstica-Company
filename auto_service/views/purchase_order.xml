<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_purchase_order_form" model="ir.ui.view">
        <field name="name">inherit.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="timer_start" widget="timer_timer"
                       class="text-danger ml-auto h2 ml-4 font-weight-bold"
                       readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="stop_timer" invisible="1"/>
                <field name="start_timer" invisible="1"/>
                <field name="timer_pause" invisible="1"/>
                <field name="is_timer_running" invisible="1"/>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="user_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
