    <record id="pre_travel_vehicle_inspection_list" model="ir.ui.view">
        <field name="name">pre.travel.vehicle.inspection.list</field>
        <field name="model">pre.travel.vehicle.inspection</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="repair_order_number"/>
                <field name="chassis_no"/>
                <field name="plate_number"/>
                <field name="date"/>
                <field name="person_conducting_disclosure"/>
            </list>
        </field>
    </record>

    <record id="pre_travel_vehicle_inspection_sequence" model="ir.sequence">
        <field name="name">pre.travel.vehicle.inspection</field>
        <field name="code">pre.travel.vehicle.inspection</field>
        <field name="prefix">Pre-Travel/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>


    <record id="pre_travel_vehicle_inspection_action" model="ir.actions.act_window">
        <field name="name">Pre Travel Vehicle Inspection</field>
        <field name="res_model">pre.travel.vehicle.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Pre Travel Vehicle Inspection
            </p>
        </field>
    </record>



