<?xml version="1.0" encoding="utf-8"?>
<odoo>

    
    <record id="pre_travel_vehicle_inspection_form" model="ir.ui.view">
        <field name="name">pre.travel.vehicle.inspection.form</field>
        <field name="model">pre.travel.vehicle.inspection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="confirm" type="object" string="Confirm"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="create_invoice" type="object" string="Create Invoice" class="oe_highlight" invisible="state != 'confirm'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirm,invoiced"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_travel_vehicle_inspection" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="count_invoices == 0">
                            <field name="count_invoices" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="repair_order_number"/>
                            <field name="partner_id"/>

                            <field name="chassis_no"/>
                            <field name="plate_number"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="person_conducting_disclosure"/>
                            <field name="original_engine_number"/>
                            <field name="product_ids" widget="many2many_tags"/>
                        </group>




                    </group>
                    <notebook>
                        <page string="Car Inspection Report">
                            <div class="container">
                                <div class="row">
                                    <div class="col-sm">
                                        Engine Sound
                                    </div>


                                    <div class="col-sm">
                                        <field name="engine_sound" widget="radio" options="{'horizontal': True}"/>
                                    </div>

                                </div>
                            </div>
                            <br/>
                            <div class="container">
                                <div class="row">
                                    <div class="col-sm">
                                        Engine Oil
                                    </div>


                                    <div class="col-sm">
                                        <field name="engine_oil" widget="radio" options="{'horizontal': True}"/>
                                    </div>

                                </div>
                            </div>
                            <br/>
