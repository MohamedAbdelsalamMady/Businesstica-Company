<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    
    <record id="inherit_project_task_form" model="ir.ui.view">
        <field name="name">inherit.project.task.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="finish_task" type="object" string="Finish Task" class="oe_highlight" invisible="is_finished == True"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="after">
                <widget name="web_ribbon" title="Finished Task" bg_color="bg-success" invisible="is_finished == False"/>
            </xpath>


            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="car_diagnoses_id"/>
                <field name="reception_information_id"/>
                <field name="task_location_id"/>
                <field name="service_name"/>
                <field name="estimated_time"/>
                <field name="is_finished" invisible="1"/>
                <field name="check_pause_time" invisible="1"/>
                <field name="success_timer" invisible="1"/>
                <field name="task_status" invisible="1"/>
                <field name="s" invisible="1"/>
                <field name="timer_check"/>
            </xpath>
            <xpath expr="//notebook[last()]" position="inside">
                <page string="Spare Parts">
                    <field name="spare_parts_task_ids" readonly="1">
                        <list editable="bottom">
                            <field name="project_task_id" invisible="1"/>
                            <field name="product_id"/>
                            <field name="uom_id"/>
<!--                            <field name="unit_price"/>-->
                            <field name="product_qty"/>
<!--                            <field name="available_quantity"/>-->
<!--                            <field name="subtotal"/>-->
                        </list>
                    </field>
                </page>


            </xpath>


        </field>
    </record>
    
    <record id="inherit_project_task_kanban" model="ir.ui.view">
        <field name="name">inherit.project.task.kanban</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="task_status"/>
            </xpath>

            <xpath expr="//div[contains(@class, 'text-muted d-flex flex-column')]" position="inside">

                <field name="task_status" widget="badge"
                       decoration-danger="task_status == '2'"
                       decoration-success="task_status == '1'"/>
            </xpath>

        </field>
    </record>
</odoo>
