<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="car_diagnoses_form" model="ir.ui.view">
        <field name="name">car.diagnoses.form</field>
        <field name="model">car.diagnoses</field>
        <field name="arch" type="xml">
            <form>
                <header>

                    <button name="view_action_send_to_pricing" type="object"
                            string="Send To Pricing" class="oe_highlight"
                            invisible="state != '1'"/>
                    <button name="create_sale_order" type="object"
                            string="Create Sale Order" class="oe_highlight"
                            invisible="state != '1'"/>
                    <button name="create_project_and_tasks" type="object"
                            string="Create Project" class="oe_highlight"
                           invisible="not sale_order_confirmed or state != '2'"/>
                    <button name="create_new_items" type="object" string="New Diagnoses Items" class="oe_highlight"
                            invisible="state in ('1', '4')"/>
                    <button name="action_timer_pause" type="object"
                            string="Timer Pause" class="btn btn-primary btn-sm"
                            invisible="stop_timer or not start_timer"/>
                    <button name="action_timer_resume" type="object"
                            string="Timer Resume" class="btn btn-primary btn-sm"
                            invisible="stop_timer or not start_timer"/>
                    <field name="timer_start" widget="timer_timer"
                           class="text-success ml-auto h2 ml-4 font-weight-bold"
                           readonly="1" invisible="s"/>
                    <field name="timer_start" widget="timer_timer"
                           class="text-danger ml-auto h2 ml-4 font-weight-bold"
                           readonly="1" invisible="not s"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="1,2,3"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_pricing" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="pricing_count == 0">
                            <field name="pricing_count" widget="statinfo"/>
                        </button>
                        <button name="action_view_sale_orders_diagnoses"
                                type="object"
                                invisible="count_sale_order == 0"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <field name="count_sale_order"
                                   widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="reception_information_id"/>
                            <field name="partner_id"/>
                            <field name="license_plate_no"/>
                            <field name="sale_order_confirmed" invisible="1"/>
                            <field name="auto_service_timers_id"/>
                        </group>
                        <group>
                            <field name="project_id"
                                   invisible="state != '3'"/>
                            <field name="date"/>
                            <field name="car_creations_id"/>
                            <field name="car_color"/>
                            <field name="assign_user_id"/>
                            <field name="service_description"/>
                            <field name="estimated_time" widget="float_time"/>
                            <field name="stop_timer" invisible="1"/>
                            <field name="start_timer" invisible="1"/>
                            <field name="timer_pause" invisible="1"/>
                            <field name="is_timer_running" invisible="1"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                            <field name="user_id" invisible="1"/>
                            <field name="check_pause_time" invisible="1"/>
                            <field name="success_timer" invisible="1"/>
                            <field name="task_status" invisible="1"/>
                            <field name="s" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Service Parts Diagnoses">
                            <field name="service_parts_diagnoses_ids">               <!-- add  context="{'default_field' : field}" to set default value -->
                                <list editable="bottom">
                                    <field name="car_diagnoses_id"
                                           invisible="1"/>       <!-- add  domain="[('id','=',parent.field)]" to set default domain -->
                                    <field name="service_name" invisible="1"/>
                                    <field name="service_name_id" invisible="1"/>
                                    <field name="product_id"/>

                                    <field name="unit_price"/>
                                    <field name="product_qty"
                                           widget="float_time"/>
                                    <!--                                    <field name="subtotal"/>-->
                                </list>
                            </field>
                        </page>
                        <page string="Spare Parts Diagnoses">
                            <field name="spare_parts_diagnoses_ids">               <!-- add  context="{'default_field' : field}" to set default value -->
                                <list editable="bottom">
                                    <field name="car_diagnoses_id"
                                           invisible="1"/>       <!-- add  domain="[('id','=',parent.field)]" to set default domain -->
                                    <field name="service_name"/>
                                    <field name="task"/>
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="product_qty"/>
                                    <field name="available_quantity"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="New Diagnoses Items" invisible="state in ['1', '4']">
                            <field name="new_diagnoses_items_ids">
                                <list editable="bottom" create="0" edit="0" delete="0">
                                    <field name="car_diagnoses_id" invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="product_uom"/>
                                    <field name="product_uom_qty"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
            </form>
        </field>
    </record>

    <record id="car_diagnoses_list" model="ir.ui.view">
        <field name="name">car.diagnoses.list</field>
        <field name="model">car.diagnoses</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="reception_information_id"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="car_creations_id"/>
                <field name="state"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <record id="car_diagnoses_search" model="ir.ui.view">
        <field name="name">car.diagnoses.search</field>
        <field name="model">car.diagnoses</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <field name="reception_information_id"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="car_creations_id"/>
                <field name="state"/>
            </search>
        </field>
    </record>


    <record id="car_diagnoses_sequence" model="ir.sequence">
        <field name="name">car.diagnoses</field>
        <field name="code">car.diagnoses</field>
        <field name="prefix">CD/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="car_diagnoses_action" model="ir.actions.act_window">
        <field name="name">Car Diagnoses</field>
        <field name="res_model">car.diagnoses</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Car Diagnoses
            </p>
        </field>
    </record>
</odoo>
