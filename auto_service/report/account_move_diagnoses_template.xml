<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="account_move_car_diagnoses_template">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page" style="page-break-inside:avoid;">
                        <h1>
                            <span t-field="o.company_id.name"/>
                        </h1>
                        <br/>
                        <div>
                            <h3>Car Maintenance Center</h3>
                        </div>
                        <table class="table table-bordered" style="page-break-inside:avoid;">
                            <tr>
                                <td>Arriving Time:
                                    <t t-if="o.reception_information_id.arriving_time">
                                        <span t-esc="o.reception_information_id.arriving_time.strftime('%d-%m-%Y')"/>
                                    </t>
                                </td>
                                <td>
                                    <strong>Diagnoses Invoice</strong>
                                </td>
                                <td>User Name
                                    <span t-esc="user.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>Invoice Date:
                                    <span t-esc="o.invoice_date"/>
                                </td>
                                <td>
                                    <strong style="background-color:#f5f5f5;">
                                        <span t-esc="o.name"/>
                                    </strong>
                                </td>
                                <td>Insurance company:*</td>
                            </tr>
                        </table>
                        <div style="height:3px;background-color:black;"/>
                        <table class="table table-bordered" style="page-break-inside:avoid;">
                            <tr>
                                <td>Work No:
                                    <span t-esc="o.car_diagnoses_id.name"/>
                                </td>
                                <td>Customer Name:
                                    <span t-esc="o.partner_id.name"/>
                                </td>
                                <td>Sales Name:
                                    <span t-esc="o.invoice_user_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>License Plate No:
                                    <span t-esc="o.car_diagnoses_id.license_plate_no"/>
                                </td>
                                <td>Chassis No:
                                    <span t-esc="o.car_diagnoses_id.car_creations_id.name"/>
                                </td>
                                <td>Phone:
                                    <span t-esc="o.partner_id.phone"/>
                                </td>
                            </tr>
                            <tr>
                                <td>Reception Employee:
                                    <span t-esc="o.reception_information_id.user_id.name"/>
                                </td>
                                <td>Car model:
                                    <span t-esc="o.reception_information_id.car_creations_id.car_brand_id.name"/>
                                    <span t-esc="o.reception_information_id.car_creations_id.car_model_id.name"/>
                                    <span t-esc="o.reception_information_id.car_creations_id.car_color"/>
                                </td>
                                <td>Speedometer(Km):
                                    <span t-esc="o.reception_information_id.now_km"/>
                                </td>
                            </tr>
                        </table>
                        <br/>
                        <t t-set="total_services" t-value="0"/>
                        <t t-set="total_services_taxes" t-value="0"/>
                        <t t-set="total_spare_parts" t-value="0"/>
                        <t t-set="total_spare_parts_taxes" t-value="0"/>
                        <div style="page-break-inside:avoid;">
                            <div class="p-3 mb-2 bg-light font-weight-bold"
                                 style="text-align:center;">
                                Services
                            </div>
                            <table class="table table-bordered" style="page-break-inside:avoid;">
                                <tr>
                                    <th>Service Code</th>
                                    <th>Service Name</th>
                                    <th>Value</th>
                                </tr>
                                <t t-foreach="o.invoice_line_ids" t-as="line">
                                    <t t-if="line.product_id.detailed_type == 'service' ">
                                        <t t-set="total_services" t-value="total_services+line.price_subtotal"/>
                                        <t t-foreach="line.tax_ids" t-as="tax">
                                            <t t-set="total_services_taxes"
                                               t-value="total_services_taxes +line.price_subtotal* tax.amount*0.01"/>
                                        </t>
                                        <tr>
                                            <td>
                                                <span t-esc="line.product_id.name"/>
                                            </td>
                                            <td>
                                                <span t-esc="line.name"/>
                                            </td>
                                            <td>
                                                <span t-esc="line.price_subtotal"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </table>
                        </div>

                        <div style="page-break-inside:avoid;">
                            <div class="p-3 mb-2 bg-light font-weight-bold"
                                 style="text-align:center;">
                                Spare parts
                            </div>
                            <table class="table table-bordered" style="page-break-inside:avoid;">
                                <tr>
                                    <th>Spare Name</th>
                                    <th>Quantity</th>
                                    <th>Price</th>
                                    <th>Value</th>
                                </tr>
                                <t t-foreach="o.invoice_line_ids" t-as="line">
                                    <t t-if="line.product_id.detailed_type != 'service' ">
                                        <t t-set="total_spare_parts" t-value="total_spare_parts+line.price_subtotal"/>
                                        <t t-foreach="line.tax_ids" t-as="tax">
                                            <t t-set="total_spare_parts_taxes"
                                               t-value="total_spare_parts_taxes +line.price_subtotal* tax.amount*0.01"/>
                                        </t>
                                        <tr>
                                            <td>
                                                <span t-esc="line.product_id.name"/>
                                            </td>
                                            <td>
                                                <span t-esc="line.quantity"/>
                                            </td>
                                            <td>
                                                <span t-esc="line.price_unit"/>
                                            </td>
                                            <td>
                                                <span t-esc="line.price_subtotal"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </table>
                        </div>

                        <br/>
                        <br/>
                        <table class="table table-sm" style="page-break-inside:avoid;">
                            <tr>
                                <th>Total Services:
                                    <span t-esc="total_services"/>
                                </th>
                                <th>Total Taxes:
                                    <span t-esc="total_services_taxes"/>
                                </th>
                                <th>Net Services:
                                    <span t-esc="total_services+total_services_taxes"/>
                                </th>
                            </tr>
                            <tr>
                                <th>Total Spare Parts:
                                    <span t-esc="total_spare_parts"/>
                                </th>
                                <th>total Spare Parts Taxes:
                                    <span t-esc="total_spare_parts_taxes"/>
                                </th>
                                <th>Net Spare Parts:
                                    <span t-esc="total_spare_parts_taxes+total_spare_parts"/>
                                </th>
                            </tr>

                        </table>
                        <div style="height:3px;background-color:black;"/>
                        <table class="table table-sm" style="page-break-inside:avoid;">
                            <tr>
                                <br/>
                                <td colspan="6">
                                    <strong>Total Net:
                                        <t t-esc="total_services+total_services_taxes+total_spare_parts_taxes+total_spare_parts"/>
                                    </strong>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Notes:-</strong>
                                    <span t-esc="o.notes"/>
                                </td>
                            </tr>
                        </table>
                        <br/>
                        <footer>
                            <table class="table table-sm" style="page-break-inside:avoid;">
                                <tr>
                                    <td>
                                        <span>Company Registry:
                                            <t t-esc="res_company.company_registry"/>
                                        </span>
                                    </td>
                                    <td>
                                        <span>Tax ID:
                                            <t t-esc="res_company.vat"/>
                                        </span>
                                    </td>
                                    <td>
                                        <span>Sale Tax:
                                            <t t-esc="res_company.sale_tax"/>
                                        </span>
                                    </td>
                                </tr>
                            </table>
                            <div style="text-align: center;">
                                <h2>Car Leaving Permission</h2>
                            </div>
                            <t t-if="o.amount_residual == 00">
                                <div>
                                    <h3>The payment of the customer-who has tagged the car to the company -
                                        the invoice
                                        is considered as a statement from him that
                                        The company has repaired all the defects contained in the order of full
                                        operation and that the car is in good condition
                                        Excellent and that he has received it without the slightest responsibility from
                                        the company for any defects that appear without what
                                        Previously fixed
                                    </h3>
                                </div>
                            </t>
                            <br/>
                            <t t-if="o.not_paid_allow_perm">
                                <div>
                                    <h3>Permission: The payment of the customer-who has tagged the car to the company -
                                        the invoice
                                        is considered as a statement from him that
                                        The company has repaired all the defects contained in the order of full
                                        operation and that the car is in good condition
                                        Excellent and that he has received it without the slightest responsibility from
                                        the company for any defects that appear without what
                                        Previously fixed
                                    </h3>
                                </div>
                                <div>
                                    <h3>Signature :
                                        <span t-esc="o.perm_user_id.name"/>
                                    </h3>
                                </div>
                            </t>
                        </footer>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

