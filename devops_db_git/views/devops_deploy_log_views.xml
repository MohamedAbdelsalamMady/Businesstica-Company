<odoo>
    <record id="view_devops_deploy_log_tree" model="ir.ui.view">
        <field name="name">devops.deploy.log.tree</field>
        <field name="model">devops.deploy.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="datetime"/>
                <field name="project_id"/>
                <field name="database_name"/>
                <field name="operation"/>
                <field name="result" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_devops_deploy_log_form" model="ir.ui.view">
        <field name="name">devops.deploy.log.form</field>
        <field name="model">devops.deploy.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="project_id"/>
                        <field name="database_name"/>
                        <field name="operation"/>
                        <field name="result"/>
                        <field name="datetime"/>
                    </group>
                    <group>
                        <field name="logs" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_devops_deploy_logs" model="ir.actions.act_window">
        <field name="name">Deployment Logs</field>
        <field name="res_model">devops.deploy.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_devops_logs" name="Deployment Logs" parent="menu_devops_root" action="action_devops_deploy_logs" sequence="20"/>
</odoo>
