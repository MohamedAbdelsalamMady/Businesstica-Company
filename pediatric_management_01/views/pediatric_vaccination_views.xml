<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pediatric_vaccination_form" model="ir.ui.view">
        <field name="name">pediatric.vaccination.form</field>
        <field name="model">pediatric.vaccination</field>
        <field name="arch" type="xml">
            <form string="Vaccination">
                <header>
                    <button name="action_complete" string="Marquer comme administré" type="object" 
                            class="oe_highlight" invisible="state != 'scheduled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="vaccine_id"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="actual_date" invisible="state == 'scheduled'"/>
                            <field name="lot_number"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Réactions, observations..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_pediatric_vaccination_list" model="ir.ui.view">
        <field name="name">pediatric.vaccination.list</field>
        <field name="model">pediatric.vaccination</field>
        <field name="arch" type="xml">
            <list string="Vaccinations" decoration-info="state == 'scheduled'" decoration-success="state == 'completed'">
                <field name="scheduled_date"/>
                <field name="patient_id"/>
                <field name="vaccine_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_pediatric_vaccine_list" model="ir.ui.view">
        <field name="name">pediatric.vaccine.list</field>
        <field name="model">pediatric.vaccine</field>
        <field name="arch" type="xml">
            <list string="Vaccins">
                <field name="name"/>
                <field name="disease"/>
                <field name="age_months"/>
                <field name="mandatory"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_pediatric_vaccination" model="ir.actions.act_window">
        <field name="name">Vaccinations</field>
        <field name="res_model">pediatric.vaccination</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_pediatric_vaccine" model="ir.actions.act_window">
        <field name="name">Catalogue des Vaccins</field>
        <field name="res_model">pediatric.vaccine</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>