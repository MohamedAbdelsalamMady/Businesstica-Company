<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pediatric_appointment_calendar" model="ir.ui.view">
        <field name="name">pediatric.appointment.calendar</field>
        <field name="model">pediatric.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Planning" 
                      date_start="appointment_date" 
                      date_stop="end_datetime" 
                      color="appointment_type" 
                      event_open_popup="True">
                <field name="patient_id"/>
                <field name="appointment_type"/>
                <field name="state" widget="badge"/>
            </calendar>
        </field>
    </record>

    <record id="view_pediatric_appointment_list" model="ir.ui.view">
        <field name="name">pediatric.appointment.list</field>
        <field name="model">pediatric.appointment</field>
        <field name="arch" type="xml">
            <list string="Rendez-vous" decoration-info="state == 'scheduled'" decoration-success="state == 'done'">
                <field name="appointment_date"/>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="appointment_type"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_pediatric_appointment_form" model="ir.ui.view">
        <field name="name">pediatric.appointment.form</field>
        <field name="model">pediatric.appointment</field>
        <field name="arch" type="xml">
            <form string="Rendez-vous">
                <header>
                    <button name="action_confirm" string="Confirmer" type="object" invisible="state != 'scheduled'" class="oe_highlight"/>
                    <button name="action_done" string="Terminer" type="object" invisible="state != 'confirmed'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="appointment_date"/>
                        </group>
                        <group>
                            <field name="duration" widget="float_time"/>
                            <field name="appointment_type"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Informations complémentaires..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_pediatric_appointment" model="ir.actions.act_window">
        <field name="name">Planning</field>
        <field name="res_model">pediatric.appointment</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
</odoo>