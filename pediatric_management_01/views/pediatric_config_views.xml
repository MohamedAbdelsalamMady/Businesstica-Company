<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pediatric_config_form" model="ir.ui.view">
        <field name="name">pediatric.config.form</field>
        <field name="model">pediatric.config</field>
        <field name="arch" type="xml">
            <form string="Configuration Cabinet">
                <sheet>
                    <group string="Informations Cabinet">
                        <group>
                            <field name="name"/>
                            <field name="specialty"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="address"/>
                        </group>
                    </group>
                    <group string="Tarifs">
                        <group>
                            <field name="consultation_price"/>
                            <field name="control_price"/>
                        </group>
                        <group>
                            <field name="vaccination_price"/>
                            <field name="emergency_price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pediatric_config" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">pediatric.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>