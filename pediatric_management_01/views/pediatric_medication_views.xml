<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View Medication -->
    <record id="view_pediatric_medication_form" model="ir.ui.view">
        <field name="name">pediatric.medication.form</field>
        <field name="model">pediatric.medication</field>
        <field name="arch" type="xml">
            <form string="Médicament">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active_substance"/>
                            <field name="form"/>
                            <field name="concentration"/>
                        </group>
                        <group>
                            <field name="min_age_months"/>
                            <field name="max_age_months"/>
                            <field name="dose_per_kg"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Posologie Pédiatrique">
                        <field name="pediatric_dosage" nolabel="1"/>
                    </group>
                    <group string="Contre-indications">
                        <field name="contraindications" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- list View Medication -->
    <record id="view_pediatric_medication_list" model="ir.ui.view">
        <field name="name">pediatric.medication.list</field>
        <field name="model">pediatric.medication</field>
        <field name="arch" type="xml">
            <list string="Médicaments">
                <field name="name"/>
                <field name="active_substance"/>
                <field name="form"/>
                <field name="concentration"/>
                <field name="min_age_months"/>
                <field name="max_age_months"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Action Medication -->
    <record id="action_pediatric_medication" model="ir.actions.act_window">
        <field name="name">Médicaments</field>
        <field name="res_model">pediatric.medication</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>