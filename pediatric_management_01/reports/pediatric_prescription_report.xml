<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_pediatric_prescription" model="ir.actions.report">
        <field name="name">Ordonnance</field>
        <field name="model">pediatric.prescription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pediatric_management.report_prescription_template</field>
        <field name="report_file">pediatric_management.report_prescription_template</field>
        <field name="print_report_name">'Ordonnance - %s' % (object.patient_id.name)</field>
        <field name="binding_model_id" ref="model_pediatric_prescription"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_prescription_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row">
                            <div class="col-6">
                                <h3>Ordonnance Médicale</h3>
                            </div>
                            <div class="col-6 text-right">
                                <p>Date: <span t-field="o.prescription_date"/></p>
                            </div>
                        </div>

                        <hr/>

                        <div class="row mt-4">
                            <div class="col-12">
                                <p><strong>Patient :</strong> <span t-field="o.patient_id.name"/></p>
                                <p><strong>Âge :</strong> <span t-field="o.patient_age"/></p>
                            </div>
                        </div>

<div class="mt-5">
    <table class="table table-sm">
        <thead>
            <tr>
                <th style="width: 40%;">Médicament</th>
                <th style="width: 60%;">Dosage / Instructions</th>
            </tr>
        </thead>
        <tbody>
            <t t-foreach="o.prescription_line_ids" t-as="line">
                <tr>
                    <td>
                        <span t-field="line.medication_id.name"/>
                    </td>
                    <td>
                        <span t-field="line.dosage_instruction"/>
                    </td>
                </tr>
            </t>
        </tbody>
    </table>
</div>

                        <div class="mt-5 text-right">
                            <p>Dr. <span t-esc="user.name"/></p>
                            <p>Pédiatre</p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>