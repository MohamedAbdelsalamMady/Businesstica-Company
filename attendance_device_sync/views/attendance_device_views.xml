<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_device_list" model="ir.ui.view">
        <field name="name">attendance.device.list</field>
        <field name="model">attendance.device</field>
        <field name="arch" type="xml">
            <list string="Attendance Devices">
                <field name="name"/>
                <field name="ip_address"/>
                <field name="port"/>
                <field name="sync_status" decoration-success="sync_status == 'synced'"
                       decoration-danger="sync_status == 'error'"/>
                <field name="last_sync_date"/>
                <field name="last_fetch_date"/>
                <field name="auto_sync" widget="boolean_toggle"/>
                <field name="auto_fetch_attendance" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_device_form" model="ir.ui.view">
        <field name="name">attendance.device.form</field>
        <field name="model">attendance.device</field>
        <field name="arch" type="xml">
            <form string="Attendance Device">
                <header>
                    <field name="sync_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group string="Device Configuration">
                            <field name="name"/>
                            <field name="ip_address"/>
                            <field name="port"/>
                            <field name="timezone"/>
                        </group>
                        <group string="Auto Sync Settings">
                            <field name="auto_sync"/>
                            <field name="auto_fetch_attendance"/>
                            <field name="last_sync_date"/>
                            <field name="last_fetch_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sync Log">
                            <field name="sync_log" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_attendance_device" model="ir.actions.act_window">
        <field name="name">Attendance Devices</field>
        <field name="res_model">attendance.device</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_attendance_device"
              name="Attendance Devices"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_attendance_device"
              sequence="10"/>
</odoo>