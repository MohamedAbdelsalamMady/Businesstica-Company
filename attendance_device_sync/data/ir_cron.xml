<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sync Employees Every Hour -->
        <record id="ir_cron_sync_employees" model="ir.cron">
            <field name="name">Auto Sync Employees to Device</field>
            <field name="model_id" ref="model_attendance_device"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_sync_employees()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Fetch Attendance Every 1 Minute -->
        <record id="ir_cron_fetch_attendance" model="ir.cron">
            <field name="name">Auto Fetch Attendance from Device</field>
            <field name="model_id" ref="model_attendance_device"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_fetch_attendance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">1</field>
        </record>
    </data>
</odoo>