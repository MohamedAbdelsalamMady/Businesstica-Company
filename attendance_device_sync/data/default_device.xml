<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Device (needs manual IP configuration) -->
        <record id="default_attendance_device" model="attendance.device">
            <field name="name">Main Device</field>
            <field name="ip_address">192.168.1.201</field>
            <field name="port">4370</field>
            <field name="active" eval="True"/>
            <field name="auto_sync" eval="True"/>
            <field name="auto_fetch_attendance" eval="True"/>
            <field name="timezone">Africa/Cairo</field>
        </record>
    </data>
</odoo>